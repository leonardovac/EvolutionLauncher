#include "src/app/resource.h"

RES_FONT RCDATA "assets\\RobotoCondensed.ttf"
RES_WARFRAME_HERO RCDATA "assets\\warframe-hero.jpg"
RES_WARFRAME_ICON RCDATA "assets\warframe.png"
RES_PUBLISHER_LOGO RCDATA "assets\publisher.png"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Content updater for Warframe"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Launcher"
            VALUE "OriginalFilename", "Launcher.exe"
            VALUE "ProductName", "WF-Launcher"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
