#include "src/app/resource.h"

RES_FONT RCDATA "assets\\RobotoCondensed.ttf"
RES_WARFRAME_HERO RCDATA "assets\\warframe-hero.jpg"
RES_WARFRAME_ICON RCDATA "assets\warframe.png"
RES_PUBLISHER_LOGO RCDATA "assets\publisher.png"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Custom launcher/updater for Digital Extremes games"
            VALUE "FileVersion", "0.1.0-alpha"
            VALUE "InternalName", "Launcher"
            VALUE "OriginalFilename", "Launcher.exe"
            VALUE "ProductName", "Evolution Launcher"
            VALUE "ProductVersion", "0.1.0-alpha"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
